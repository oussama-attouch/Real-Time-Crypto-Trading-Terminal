<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      ============================================================================
      Spring Boot 3.5.16 — latest patch of the 3.5.x line (the final 3.x line).
      Verified against Maven Central maven-metadata.xml on 2025-11-05:
        3.5.0 ... 3.5.16 (this), then 4.0.x / 4.1.x / 4.2.0-RC2 (Spring Boot 4).
      We deliberately stay on 3.5.x: Boot 4.x requires Spring Framework 7 and
      moves to Jakarta EE 11 / a different module layout, which is a migration,
      not a Phase-1 concern. Bump the <version> below to move lines later.
      ============================================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- always resolve the parent from the repository -->
    </parent>

    <groupId>com.terminal</groupId>
    <artifactId>crypto-trading-terminal</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>crypto-trading-terminal</name>
    <description>Real-time crypto trading terminal :: Phase 1 = Binance -&gt; Kafka -&gt; STOMP/WebSocket</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
          NO versions for spring-kafka / kafka-clients / reactor / jackson below.
          They are governed by spring-boot-dependencies (the "Boot BOM"), which is
          the only way to guarantee a tested, mutually compatible set. Pinning them
          by hand is the #1 source of "works on my machine" Kafka breakage.
          Run `mvn dependency:tree` to see the resolved versions.
        -->
    </properties>

    <dependencies>

        <!-- ==================== SERVLET / STOMP SERVER STACK ==================== -->
        <!--
          The *server* side is intentionally Spring MVC on Tomcat, not WebFlux.
          Reason: STOMP over WebSocket (SockJS) is served by spring-messaging's
          SimpMessagingTemplate + a servlet WebSocket handler. Spring's reactive
          WebSocket server does not speak STOMP. Requirements ask for STOMP, so
          the embedded container must be servlet-based.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- STOMP broker relay / simple broker + SockJS fallback endpoint. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- ===================== REACTIVE *CLIENT* LIBRARY ====================== -->
        <!--
          WebFlux is used ONLY as a client library here:
            - spring-webflux  -> WebClient API, reactor-core (retryWhen/backoff)
            - reactor-netty-http -> ReactorNettyWebSocketClient
          It is NOT used to serve HTTP.

          Boot's rule (WebApplicationType.deduceFromClasspath): if Spring MVC is
          present, the app type is SERVLET and WebFlux auto-configuration backs
          off (@ConditionalOnWebApplication(REACTIVE)). So the two starters
          coexist safely: MVC serves, WebFlux is just a dependency.

          Consequence to keep in mind for Step 2: WebClient.Builder auto-config
          is not guaranteed on the servlet stack, so we will construct
          ReactorNettyWebSocketClient explicitly rather than rely on auto-config.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- ============================ KAFKA ================================== -->
        <!--
          Version managed by Boot (spring-kafka 3.3.x for Boot 3.5.x), which in
          turn brings a kafka-clients 3.9.x. Kafka 4.x brokers in KRaft mode still
          speak the 3.x client protocol (brokers support clients >= 2.1), so this
          is compatible with the apache/kafka:4.3.1 image in docker-compose.yml.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ======================== PERSISTENCE (READY) ======================== -->
        <!--
          Postgres is provisioned in Phase 1 but not yet on the hot path. We take
          plain JDBC (HikariCP + JdbcTemplate), NOT JPA/R2DBC, because:
            - no domain model exists yet, so an ORM is pure overhead;
            - R2DBC would force a reactive DB driver on an MVC stack for nothing.
          HikariCP is configured to fail lazily (initialization-fail-timeout: -1),
          so the service still boots when Postgres is down.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
          Write side (Phase 8): persisted orders.
          JPA earns its place only now that there is a real domain model to map. The read
          path (trades / candles / depth) still never touches the database.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          Flyway owns the schema; Hibernate is set to ddl-auto=none.
          flyway-database-postgresql is mandatory from Flyway 10 onwards — the core module
          no longer bundles every dialect, and without it startup fails with
          "Unsupported Database: PostgreSQL". Both versions come from the Boot BOM.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================== OPERATIONS =============================== -->
        <!-- /actuator/health + metrics: how we prove the pipeline is alive. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- @Validated on @ConfigurationProperties (fails fast on bad config). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========================== LOMBOK ================================== -->
        <!--
          scope=provided + optional=true: never packaged into the fat jar.
          Compile-time only (@Slf4j, @RequiredArgsConstructor).
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Generates IDE metadata for our terminal.* properties. Build-time only. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- =========================== TESTING ================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Embedded broker + KafkaTemplate/Listener test utilities for Phase 1 tests. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>crypto-trading-terminal</finalName>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      Explicit annotation-processor paths. Since JDK 23 annotation
                      processors are no longer discovered from the classpath, so we
                      declare them now (works on 21, future-proof for 23+).
                      ${lombok.version} comes from the Boot BOM; the processor is
                      versioned with the parent so it can never drift.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${project.parent.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-serial</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!--
                  No <executions> block here on purpose: spring-boot-starter-parent
                  already binds `repackage` to the package phase (execution id
                  "repackage"). Declaring it again runs the goal twice, which
                  rewrites the jar and renames the .original artifact twice.
                -->
                <configuration>
                    <!-- Keep Lombok out of the executable jar. -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
